{
  "name": "dracula-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:cards": "node scripts/prepare-card-assets.mjs",
    "predev": "npm run prepare:cards",
    "dev": "vite",
    "preview": "vite preview",
    "pretest": "npm run prepare:cards",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prebuild": "npm run prepare:cards",
    "build": "tsc --noEmit && vite build",
    "verify:build": "npm run build && node scripts/verify-production-build.mjs",
    "check": "npm run test && npm run lint && npm run verify:build"
  },
  "dependencies": {
    "@fontsource/grenze-gotisch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.0",
    "vitest": "^4.0.0"
  }
}
